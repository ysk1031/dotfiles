# Homebrew
eval "$(/opt/homebrew/bin/brew shellenv)"
typeset -U fpath

# Mise
eval "$("$HOME/.local/bin/mise" activate zsh)"
# Shims as a fallback: activate updates PATH only from the prompt hook,
# which non-interactive shells (Claude Code's Bash tool) never run.
export PATH="$PATH:$HOME/.local/share/mise/shims"

# claude, mise -- the tools that stay outside mise's control
export PATH="$HOME/.local/bin:$PATH"

# Go
export PATH="$(go env GOPATH)/bin:$PATH"

# keg-only なので brew shellenv では PATH に乗らない
export PATH="/opt/homebrew/opt/mysql-client@8.0/bin:$PATH"

# Locale
export LC_ALL=en_US.UTF-8

# Container
export CONTAINER_DEFAULT_PLATFORM=linux/arm64

# crit
export CRIT_NO_UPDATE_CHECK=1
